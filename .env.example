# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Optional: the site runs without it and all tracking calls no-op.
# Set locally in .env or on Netlify: netlify env:set VITE_GA_ID G-XXXXXXXXXX
VITE_GA_ID=

# Supabase booking queue (project: capitalclear). Optional: without these
# the request flow and partner dashboard run fully simulated.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (Stripe Connect). Set to "true" to enable the pay-to-book flow.
# The Stripe secret keys live as Supabase secrets, not here.
VITE_STRIPE_ENABLED=
