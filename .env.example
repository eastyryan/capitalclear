# ---------------------------------------------------------------------------
# Capital Clear — environment variables
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Money is stored as integer cents CAD; scheduling displays in America/Toronto.
# ---------------------------------------------------------------------------

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Forward-compatible name used by current Supabase docs (same value as the anon
# key for now). Legacy anon/JWT keys are being deprecated — this is the migration
# path. Code currently reads NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# "simulated" uses the in-app provider (no Stripe keys needed). Flip to "stripe"
# later to use Stripe Connect Express with no schema/UI changes.
PAYMENTS_MODE=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform fee in basis points (1500 = 15%).
STRIPE_PLATFORM_FEE_BPS=1500

# --- Maps / address autocomplete (pluggable; manual entry + FSA validation now) ---
NEXT_PUBLIC_MAPS_PROVIDER=
NEXT_PUBLIC_MAPS_API_KEY=
